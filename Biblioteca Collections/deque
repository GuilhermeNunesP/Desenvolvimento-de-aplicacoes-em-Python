from collections import deque

historico = deque(maxlen=3)

historico.append("pagina 1")
historico.append("pagina 2")
historico.append("pagina 3")
historico.append("pagina 4")
print(f"Historico atual: {historico}")

historico.append("pagina 5")
print(f"Apos nova pagina: {historico}")

fila = deque(["Caroline", "Samira", "Juliana"])

fila.appendleft("Mayara")

ultimo = fila.pop()

print(f"Fila final: {fila}")
print(f"Quem saiu por ultimo: {ultimo}")
