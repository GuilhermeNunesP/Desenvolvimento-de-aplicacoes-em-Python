from dataclasses import dataclass


@dataclass
class Marca:
    id: int
    nome: str
    sigla: str
    pais_origem: str = "Brasil"
    @property
    def pais_origem(self):
        return self._pais_origem
    @classmethod
    def set_pais_origem(cls, pais_origem: str):
        cls._pais_origem = "pais_origem"
