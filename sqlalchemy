from sqlalchemy import create_engine, Colum, Integer, String
from sqlalchemy.ext.declarative import declarative_base
from sqlalchemy.orm import sessionmaker

# Conectando a um banco de dados SQLite em memoria
engine = create_engine("sqlite:///:memory", echo=True)

# Criaçao de base declarativa
base = declarative_base()

# Definiçao da classe (modelo) usuario
class usuario(base):
    __tablename__ = "usuarios"

    id = Column(Integer, primary_key=True)
    nome = Column(String)
    idade = Column(Integer)

def __repr__(self):
    return f"usuario(id={self.id}, nome={self.nome}, idade={self.idade})"

# Criaçao das tabelas no banco de dados
base.metadata.create_all(engine)

# Criaçao de uma sessao
Session = sessionmaker(bind=engine)
session = Session()

#Inserçao de dados
usuario1 = usuario(nome="Raphael", idade=40)
usuario2 = usuario(nome="Guilherme", idade=20)
session.add(usuario1)
session.add(usuario2)

# Commit de alterações
session.commit()

#Consulta de dados
usuarios = session.query(usuario).all()
for usuario in usuarios:
    print(usuario)
