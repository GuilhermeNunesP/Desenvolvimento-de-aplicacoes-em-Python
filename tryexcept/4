import os 

def criar_diretorio(nome_diretorio: str)-> None:
    try:
        os.makedirs(nome_diretorio)
        print(f"Diretorio {nome_diretorio} foi criado")
    except FileExistsError:
        print(f"Diretorio ja existe")
    except PermissionError:
        print("Permissao negada")
    except Exception as e:
        print(f"Ocorreu um erro ao criar {e}")  

def criar_arquivo(nome_arquivo: str, conteudo:str)-> None:
    try:
        with open(nome_arquivo, "w") as file:
            file.write(conteudo)
        print(f"Arquivo {nome_arquivo} foi criado")
    except FileExistsError:
        print(f"Arquivo ja existe")
    except PermissionError:
        print("Permissao negada")
    except Exception as e:
        print("Ocorreu um erro ao criar {e}")   

def main() -> None:
    diretorio_atual = os.getcwd()
    print(f"Caminho com getcwd(): {diretorio_atual}")
    diretorio_atual = os.path.dirname(os.path.asbpath(__file__))
    print(f"Caminho com os path: {diretorio_atual}")
    nome_diretorio = os.path.join(diretorio_atual, "diretorio_aula")
    arquivo_nome = os.path.join(nome_diretorio, "arquivo_aula.txt")
    conteudo = "Exemplo"
    try:
        criar_diretorio(nome_diretorio)
        criar_arquivo(arquivo_nome, conteudo)
    except FileNotFoundError:
        print("Arquivo não encontrado")
    except PermissionError:
        print("Permissao negada para acesso")
    except Exception as e:
        print(f"Erro Inesperado: {e}")




if __name__ == "__main__":
   main()
