import pickle

def criapickle(dados: str, modo:  list)-> None:
    try:
        with open(dados, modo) as salva_binario:
            pickle.dump(dados, salva_binario)
            print("Dados salvos")
    except pickle.PicklingError as e:
        print(f"Ocorreu um erro ao salvar {e}")

def lepicler(dados:str, modo:list)->None:
    try:
        with open(dados, modo) as carrega_binario:
            dados_carregados = pickle.load(carrega_binario)
        print("Dados Carregados")
    except pickle.UnpicklingError as e:
        print(f"Ocorreu um erro ao salvar {e}")

    


